# --- Depo ve defter ---
# STORE=fs → .data/assets (Docker gerekmez) · STORE=s3 → RustFS (yerel) / Cloudflare R2
STORE=fs
# LEDGER=jsonl → .data/ledger.jsonl · LEDGER=db → Postgres
LEDGER=jsonl
# fal'da endpoint'i henüz doğrulanmamış modelleri aç (Kling 3, Seedance 2)
FAL_ENABLE_UNVERIFIED=0

# --- Altyapı (docker compose ile yerelde) ---
DATABASE_URL=postgres://ys:ys@localhost:5433/youtube_studio
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=ys-assets
S3_ACCESS_KEY_ID=ysrustfs
S3_SECRET_ACCESS_KEY=ysrustfs-secret

# --- Bulut sağlayıcılar (boş bırakılanlar router'da devre dışı kalır) ---
FAL_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# Model kimlikleri sık değişiyor; burada ezilebilir.
GEMINI_IMAGE_MODEL=gemini-3-pro-image
GEMINI_IMAGE_FAST_MODEL=gemini-3.1-flash-image
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VEO_MODEL=veo-3.1-generate-preview
ELEVENLABS_TTS_MODEL=eleven_v3

# --- Yerel GPU ---
COMFYUI_URL=http://127.0.0.1:8188

# --- Claude ajanları (boşsa Claude Code girişi / Max aboneliği kullanılır) ---
# ANTHROPIC_API_KEY=
YS_MODEL_CREATIVE=claude-opus-5-5
YS_MODEL_FAST=claude-sonnet-5-5
YS_MODEL_CHEAP=claude-haiku-5-5

# --- Orkestrasyon ---
TRIGGER_PROJECT_REF=
YS_WORK_DIR=.data/episodes
